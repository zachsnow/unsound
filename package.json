{
  "name": "unsound",
  "version": "0.2.0",
  "description": "Extensible programming language framework for building custom languages through composition",
  "keywords": ["compiler", "language", "extensible", "metaprogramming", "lsp"],
  "license": "MIT",
  "author": "Zach Snow",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zachsnow/unsound.git"
  },
  "homepage": "https://unsound.vein.io",
  "bugs": {
    "url": "https://github.com/zachsnow/unsound/issues"
  },
  "type": "module",
  "main": "src/extension.ts",
  "bin": {
    "usc": "./src/cli.ts",
    "usc-language-server": "./src/lsp/server.ts"
  },
  "scripts": {
    "usc": "bun src/cli.ts",
    "test": "bun src/test.ts",
    "types": "tsc --noEmit && cd editors/vscode && bun run types",
    "clean": "rm -rf dist && find . -name '*.us.js' -type f -delete",
    "build:binary": "./build-binary.sh"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "bun-types": "^1.3.3",
    "typescript": "^5.9.3",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11"
  }
}
