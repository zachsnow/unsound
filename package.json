{
  "name": "unsound",
  "version": "0.2.0",
  "type": "module",
  "main": "src/extension.ts",
  "bin": {
    "usc": "./src/cli.ts",
    "usc-language-server": "./src/lsp/server.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "usc": "bun src/cli.ts",
    "test": "bun src/test.ts",
    "types": "tsc --noEmit && cd editors/vscode && bun run types",
    "clean": "rm -rf dist && find . -name '*.us.js' -type f -delete",
    "build:binary": "./build-binary.sh"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "bun-types": "^1.3.3",
    "typescript": "^5.9.3",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11"
  }
}
