//usc -x meso
// thermo.us - The hot layer
// Builds on meso to make Unsound more JS-like with proper statements
//
// Adds:
//   - Statements: let x = v; (binding) and expr; (expression statement)
//   - Blocks: { stmt; stmt; expr } (statements followed by result expression)
//   - Variable assignment: x = v (mutates existing binding, returns value)
//   - If without else: if cond then expr (returns undefined when false)
//
// Key difference from core:
//   - Core has "let x = v in body" (expression with body)
//   - Thermo has "let x = v;" (statement, only valid in blocks/programs)
//
// Meso provides operators, thermo makes it imperative.
// Note: Member assignment (o.x = v) is handled by core as SetIndex.

// === Parser Extension ===

let thermoParseExtension = ($) =>
  let baseAppExpr = $.appExpr in
  let baseAtom = $.atom in

  // === Statement parsing ===

  // Parse a let statement: let x = v (no body, no "in")
  // Returns { type: "LetStmt", name, value }
  let _ = $.letStmt = () => (input, pos) =>
    let kw = $.letKeyword()(input, pos) in
    if !(kw.ok) then { ok: false, expected: "let", pos: pos }
    else
      let binding = $.letBinding()(input, kw.pos) in
      if !(binding.ok) then { ok: false, expected: "identifier", pos: kw.pos }
      else
        let value = $.letInitializer()(input, binding.pos) in
        if !(value.ok) then value
        else {
          ok: true,
          value: { type: "LetStmt", name: binding.value.name, nameLoc: binding.value.nameLoc, value: value.value },
          pos: value.pos
        }
  in

  // Parse a statement: LetStmt or expression (which becomes ExprStmt when followed by ;)
  // This doesn't consume the semicolon - that's handled by stmtList
  let _ = $.stmt = () => (input, pos) =>
    // Try let statement first
    let letResult = $.letStmt()(input, pos) in
    if letResult.ok then letResult
    else
      // Otherwise it's an expression
      let exprResult = $.expr()(input, pos) in
      if !(exprResult.ok) then exprResult
      else {
        ok: true,
        value: { type: "ExprStmt", expr: exprResult.value },
        pos: exprResult.pos
      }
  in

  // Parse a list of statements (each followed by ;) and optional final expression
  // Returns { stmts: [...], result: expr | null }
  let _ = $.stmtList = () => (input, isEnd, endMsg) =>
    let loop = (p, stmts) =>
      let ws = $.ws()(input, p) in
      let end = isEnd(ws.pos) in
      if end.ok then { ok: true, value: { stmts: stmts, result: null }, pos: end.pos }
      else
        // Try to parse a statement or expression
        let stmtResult = $.stmt()(input, ws.pos) in
        if !(stmtResult.ok) then
          if stmtResult.pos > ws.pos then stmtResult
          else { ok: false, expected: "statement or " + endMsg, pos: ws.pos }
        else
          let ws2 = $.ws()(input, stmtResult.pos) in
          let semi = $.token(";")(input, ws2.pos) in
          if semi.ok then
            // Has semicolon - it's a statement, continue parsing
            let newStmts = stmts.concat([stmtResult.value]) in
            loop(semi.pos, newStmts)
          else
            // No semicolon - check if this is the final expression
            let end2 = isEnd(ws2.pos) in
            if end2.ok then
              // It's the result expression (convert ExprStmt back to expr if needed)
              let result = if stmtResult.value.type == "ExprStmt" then stmtResult.value.expr
                           else stmtResult.value in
              // If it's a LetStmt without semicolon, that's an error
              if result.type == "LetStmt" then
                { ok: false, expected: "; after let statement", pos: ws2.pos }
              else
                { ok: true, value: { stmts: stmts, result: result }, pos: end2.pos }
            else
              { ok: false, expected: "; or " + endMsg, pos: ws2.pos }
    in
    loop
  in

  // === Block parsing ===
  // Parse a block: { stmt; stmt; expr? }
  // Returns { type: "Block", stmts: [...], result: expr | null }
  let _ = $.block = () => (input, pos) =>
    let open = $.token("{")(input, pos) in
    if !(open.ok) then { ok: false, pos: pos }
    else
      let ws = $.ws()(input, open.pos) in
      // Check for empty block
      let close = $.token("}")(input, ws.pos) in
      if close.ok then
        { ok: true, value: { type: "Block", stmts: [], result: null }, pos: close.pos }
      else
        let isClose = (p) => $.token("}")(input, p) in
        let content = $.stmtList()(input, isClose, "}")(ws.pos) in
        if !(content.ok) then content
        else
          { ok: true, value: { type: "Block", stmts: content.value.stmts, result: content.value.result }, pos: content.pos }
  in

  // Override atom to try block first, then fall back to base
  let _ = $.atom = () => (input, pos) =>
    let blockResult = $.block()(input, pos) in
    if blockResult.ok then blockResult
    else baseAtom()(input, pos)
  in

  // === Variable assignment parsing ===
  // Parse variable assignment: ident = expr
  // RHS uses $.expr() so lambdas and other expressions work
  let _ = $.varAssign = () => (input, pos) =>
    let result = baseAppExpr()(input, pos) in
    if !(result.ok) then result
    else if result.value.type == "Ident" then
      // Check for = (but not ==)
      let ws = $.ws()(input, result.pos) in
      let ch1 = input.slice(ws.pos, ws.pos + 1) in
      let ch2 = input.slice(ws.pos + 1, ws.pos + 2) in
      if ch1 == "=" then
        if ch2 == "=" then result  // It's ==, not assignment
        else
          // It's assignment! Parse RHS as full expression
          let rhsResult = $.expr()(input, ws.pos + 1) in
          if !(rhsResult.ok) then rhsResult
          else {
            ok: true,
            value: { type: "Assign", name: result.value.name, value: rhsResult.value },
            pos: rhsResult.pos
          }
      else result
    else result
  in

  // Override appExpr to add assignment parsing
  let _ = $.appExpr = () => (input, pos) =>
    $.varAssign()(input, pos)
  in

  // === If expression override ===
  // Override ifExpr to make else optional
  let _ = $.ifExpr = () => (input, pos) =>
    let kw = $.ifKeyword()(input, pos) in
    if !(kw.ok) then { ok: false, expected: "if", pos: pos }
    else
      let cond = $.ifCondition()(input, kw.pos) in
      if !(cond.ok) then cond
      else
        let thenKw = $.thenKeyword()(input, cond.pos) in
        if !(thenKw.ok) then { ok: false, expected: "then", pos: cond.pos }
        else
          let thenExpr = $.thenBranch()(input, thenKw.pos) in
          if !(thenExpr.ok) then thenExpr
          else
            // Try to parse else (optional in thermo)
            let elseKw = $.elseKeyword()(input, thenExpr.pos) in
            if elseKw.ok then
              let elseExpr = $.elseBranch()(input, elseKw.pos) in
              if !(elseExpr.ok) then elseExpr
              else {
                ok: true,
                value: { type: "IfExpr", cond: cond.value, "then": thenExpr.value, "else": elseExpr.value },
                pos: elseExpr.pos
              }
            else
              // No else - use Void for else branch
              {
                ok: true,
                value: { type: "IfExpr", cond: cond.value, "then": thenExpr.value, "else": { type: "Void" } },
                pos: thenExpr.pos
              }
  in

  // === Program override ===
  // Program is like an implicit block: stmt; stmt; expr?
  let _ = $.program = () => (input, pos) =>
    let isEof = (p) => $.eof()(input, p) in
    let content = $.stmtList()(input, isEof, "end of input")(pos) in
    if !(content.ok) then content
    else
      // Convert stmtList result to Block (or just the result expr if no stmts)
      if content.value.stmts.length == 0 then
        if content.value.result == null then
          { ok: true, value: { type: "Void" }, pos: content.pos }
        else
          { ok: true, value: content.value.result, pos: content.pos }
      else
        { ok: true, value: { type: "Block", stmts: content.value.stmts, result: content.value.result }, pos: content.pos }
  in

  // === Override letExpr to fail ===
  // In thermo, "let x = v in body" is not supported - use blocks instead
  let _ = $.letExpr = () => (input, pos) =>
    { ok: false, expected: "expression", pos: pos }
  in

  {}

in

// === Compiler Extension ===

let thermoCompileExtension = ($) =>
  let baseCompileExpr = $.compileExpr in

  // Compile a block by nesting lets and sequencing expressions
  // { let x = 1; let y = 2; expr1; x + y }
  // becomes: let x = 1 in (let y = 2 in (seq(expr1, x + y)))
  let compileBlock = (stmts, result) =>
    let resultIr = if result == null then $.ir.lit(undefined) else $.compileExpr(result) in
    // Process statements in reverse order to build nested structure
    let processStmts = (idx) =>
      if idx < 0 then resultIr
      else
        let stmt = stmts[idx] in
        let inner = processStmts(idx - 1) in
        if stmt.type == "LetStmt" then
          // let x = v becomes let binding
          $.ir.let(stmt.name, $.compileExpr(stmt.value), inner)
        else if stmt.type == "ExprStmt" then
          // expr; becomes seq(expr, rest)
          $.ir.seq($.compileExpr(stmt.expr), inner)
        else
          // Shouldn't happen, but compile it anyway
          $.ir.seq($.compileExpr(stmt), inner)
    in
    processStmts(stmts.length - 1)
  in

  let _ = $.compileExpr = (expr) =>
    if expr.type == "Void" then $.ir.lit(undefined)
    else if expr.type == "Block" then
      compileBlock(expr.stmts, expr.result)
    else if expr.type == "Assign" then
      $.ir.$("assign", $.ir.var("$env"), $.ir.string(expr.name), $.compileExpr(expr.value))
    else baseCompileExpr(expr)
  in
  {}

in

// === Interpreter Extension ===

let thermoInterpretExtension = ($) =>
  // Assignment: mutate existing binding in $env, return the value
  let _ = $.assign = ($env, name, value) =>
    let _ = $env.mutate(name, value) in
    value
  in
  {}

in

// === The Extension ===

{
  name: "thermo",
  description: "JS-like imperative features: statements, blocks, assignment, if without else",
  requires: "meso",
  version: "2.0.0",
  $parse: thermoParseExtension,
  $compile: thermoCompileExtension,
  $interpret: thermoInterpretExtension
}
