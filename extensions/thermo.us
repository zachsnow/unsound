//usc -x meso
// thermo.us - The hot layer
// Builds on meso to make Unsound more JS-like
//
// Adds:
//   - Statements: semicolon-separated, scoping via blocks
//   - Let statement: let x = v; (no 'in', scopes to end of block)
//   - Blocks: { stmt; stmt; expr } (evaluates to last expression)
//   - Variable assignment: x = v (mutates existing binding)
//   - If without else: if cond then expr (returns undefined when false)
//
// AST nodes:
//   Block: { type: "Block", stmts: [stmt, ...] }
//   LetStmt: { type: "LetStmt", name: string, value: expr }
//   Assign: { type: "Assign", name: string, value: expr }
//   Void: { type: "Void" }

// === Parser Extension ===

let thermoParseExtension = ($) =>
  let baseAppExpr = $.appExpr in
  let baseAtom = $.atom in

  // === Statement parsing ===
  // A statement is either a let binding or an expression.
  // $.statement parses a single statement.
  // $.statements parses semicolon-separated statements until terminator.

  // Parse let statement: let name = value
  // Returns LetStmt node (no body - scoping handled by Block compilation)
  let _ = $.letStmt = () => (input, pos) =>
    let kw = $.letKeyword()(input, pos) in
    if !(kw.ok) then { ok: false, pos: pos }
    else
      let binding = $.letBinding()(input, kw.pos) in
      if !(binding.ok) then { ok: false, expected: "identifier", pos: kw.pos }
      else
        let value = $.letInitializer()(input, binding.pos) in
        if !(value.ok) then value
        else {
          ok: true,
          value: { type: "LetStmt", name: binding.value.name, value: value.value },
          pos: value.pos
        }
  in

  // Remove let...in expression syntax - thermo uses statement-based let
  let _ = $.letExpr = () => (input, pos) => { ok: false, pos: pos } in

  // Parse a single statement: letStmt or expr
  let _ = $.statement = () => (input, pos) =>
    let letResult = $.letStmt()(input, pos) in
    if letResult.ok then letResult
    else $.expr()(input, pos)
  in

  // Parse statements until terminator (isEnd returns ok: true at end)
  // Returns array of statement AST nodes
  let _ = $.statements = () => (input, isEnd) =>
    let loop = (p, acc) =>
      let ws = $.ws()(input, p) in
      let end = isEnd(ws.pos) in
      if end.ok then { ok: true, value: acc, pos: end.pos }
      else
        let stmt = $.statement()(input, ws.pos) in
        if !(stmt.ok) then stmt
        else
          let ws2 = $.ws()(input, stmt.pos) in
          let semi = $.token(";")(input, ws2.pos) in
          if semi.ok then
            loop(semi.pos, acc.concat([stmt.value]))
          else
            // No semicolon - must be end or error
            let end2 = isEnd(ws2.pos) in
            if end2.ok then { ok: true, value: acc.concat([stmt.value]), pos: end2.pos }
            else { ok: false, expected: ";", pos: ws2.pos }
    in
    loop
  in

  // Convert statement array to Block or single statement
  let _ = $.stmtsToExpr = (stmts) =>
    if stmts.length == 0 then { type: "Void" }
    else if stmts.length == 1 then stmts[0]
    else { type: "Block", stmts: stmts }
  in

  // === Block parsing ===
  // { stmt; stmt; expr }
  let _ = $.block = () => (input, pos) =>
    let open = $.token("{")(input, pos) in
    if !(open.ok) then { ok: false, pos: pos }
    else
      let ws = $.ws()(input, open.pos) in
      // Check for empty block - treat as empty object, not block
      let close = $.token("}")(input, ws.pos) in
      if close.ok then { ok: false, pos: pos }
      else
        // Try to parse first statement
        let first = $.statement()(input, ws.pos) in
        if !(first.ok) then { ok: false, pos: pos }
        else
          let ws2 = $.ws()(input, first.pos) in
          let semi = $.token(";")(input, ws2.pos) in
          if semi.ok then
            // Multiple statements
            let isClose = (p) => $.token("}")(input, p) in
            let rest = $.statements()(input, isClose)(semi.pos, []) in
            if !(rest.ok) then rest
            else {
              ok: true,
              value: $.stmtsToExpr([first.value].concat(rest.value)),
              pos: rest.pos
            }
          else
            // Single statement - check for close
            let close2 = $.token("}")(input, ws2.pos) in
            if close2.ok then
              // { ident } is object shorthand, not block
              if first.value.type == "Ident" then { ok: false, pos: pos }
              else { ok: true, value: first.value, pos: close2.pos }
            else
              // Not a valid block
              { ok: false, pos: pos }
  in

  // Override atom to try block first
  let _ = $.atom = () => (input, pos) =>
    let blockResult = $.block()(input, pos) in
    if blockResult.ok then blockResult
    else baseAtom()(input, pos)
  in

  // === Variable assignment ===
  let _ = $.varAssign = () => (input, pos) =>
    let result = baseAppExpr()(input, pos) in
    if !(result.ok) then result
    else if result.value.type == "Ident" then
      let ws = $.ws()(input, result.pos) in
      let ch1 = input.slice(ws.pos, ws.pos + 1) in
      let ch2 = input.slice(ws.pos + 1, ws.pos + 2) in
      if ch1 == "=" && !(ch2 == "=") then
        let rhsResult = $.expr()(input, ws.pos + 1) in
        if !(rhsResult.ok) then rhsResult
        else {
          ok: true,
          value: { type: "Assign", name: result.value.name, value: rhsResult.value },
          pos: rhsResult.pos
        }
      else result
    else result
  in

  let _ = $.appExpr = () => (input, pos) =>
    $.varAssign()(input, pos)
  in

  // === If without else ===
  let _ = $.ifExpr = () => (input, pos) =>
    let kw = $.ifKeyword()(input, pos) in
    if !(kw.ok) then { ok: false, expected: "if", pos: pos }
    else
      let cond = $.ifCondition()(input, kw.pos) in
      if !(cond.ok) then cond
      else
        let thenKw = $.thenKeyword()(input, cond.pos) in
        if !(thenKw.ok) then { ok: false, expected: "then", pos: cond.pos }
        else
          let thenExpr = $.thenBranch()(input, thenKw.pos) in
          if !(thenExpr.ok) then thenExpr
          else
            let elseKw = $.elseKeyword()(input, thenExpr.pos) in
            if elseKw.ok then
              let elseExpr = $.elseBranch()(input, elseKw.pos) in
              if !(elseExpr.ok) then elseExpr
              else {
                ok: true,
                value: { type: "IfExpr", cond: cond.value, "then": thenExpr.value, "else": elseExpr.value },
                pos: elseExpr.pos
              }
            else {
              ok: true,
              value: { type: "IfExpr", cond: cond.value, "then": thenExpr.value, "else": { type: "Void" } },
              pos: thenExpr.pos
            }
  in

  // === Program: top-level statements ===
  let _ = $.program = () => (input, pos) =>
    let isEof = (p) => $.eof()(input, p) in
    let result = $.statements()(input, isEof)(pos, []) in
    if !(result.ok) then result
    else { ok: true, value: $.stmtsToExpr(result.value), pos: result.pos }
  in

  {}
in

// === Compiler Extension ===

let thermoCompileExtension = ($) =>
  let baseCompileExpr = $.compileExpr in

  // Compile statements: each LetStmt scopes over the rest
  let compileStmts = (stmts, idx) =>
    if idx >= stmts.length then $.ir.lit(undefined)
    else
      let stmt = stmts[idx] in
      let isLast = idx == stmts.length - 1 in
      if stmt.type == "LetStmt" then
        // let x = v; rest -> $.let($env, "x", value, rest)
        $.ir.$("let",
          $.ir.var("$env"),
          $.ir.string(stmt.name),
          $.ir.arrow(["$env"], $.compileExpr(stmt.value)),
          $.ir.arrow(["$env"], compileStmts(stmts, idx + 1))
        )
      else if isLast then
        $.compileExpr(stmt)
      else
        $.ir.seq($.compileExpr(stmt), compileStmts(stmts, idx + 1))
  in

  let _ = $.compileExpr = (expr) =>
    if expr.type == "Void" then $.ir.lit(undefined)
    else if expr.type == "Block" then compileStmts(expr.stmts, 0)
    else if expr.type == "LetStmt" then
      // Standalone LetStmt - bind and return undefined
      $.ir.$("let",
        $.ir.var("$env"),
        $.ir.string(expr.name),
        $.ir.arrow(["$env"], $.compileExpr(expr.value)),
        $.ir.arrow(["$env"], $.ir.lit(undefined))
      )
    else if expr.type == "Assign" then
      $.ir.$("assign", $.ir.var("$env"), $.ir.string(expr.name), $.compileExpr(expr.value))
    else baseCompileExpr(expr)
  in

  {}
in

// === Interpreter Extension ===

let thermoInterpretExtension = ($) =>
  let _ = $.assign = ($env, name, value) =>
    let _ = $env.mutate(name, value) in
    value
  in
  {}
in

// === The Extension ===

{
  name: "thermo",
  description: "JS-like imperative features: statements, blocks, assignment",
  requires: "meso",
  version: "2.0.0",
  $parse: thermoParseExtension,
  $compile: thermoCompileExtension,
  $interpret: thermoInterpretExtension
}
