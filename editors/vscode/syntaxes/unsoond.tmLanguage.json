{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Unsound",
  "scopeName": "source.unsound",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.unsound",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.unsound",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.unsound",
              "match": "\\\\(?:[\"\\\\ntr])"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.unsound",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.unsound",
          "match": "\\b(if|then|else|return|do)\\b"
        },
        {
          "name": "keyword.other.unsound",
          "match": "\\b(let|import|from)\\b"
        },
        {
          "name": "storage.type.unsound",
          "match": "::"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.unsound",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.unsound",
          "match": "\\b(null|undefined)\\b"
        },
        {
          "name": "variable.language.this.unsound",
          "match": "\\b(this)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.unsound",
          "match": "=>"
        },
        {
          "name": "keyword.operator.comparison.unsound",
          "match": "===|!==|==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.unsound",
          "match": "\\|\\||&&|!"
        },
        {
          "name": "keyword.operator.arithmetic.unsound",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.assignment.unsound",
          "match": "="
        },
        {
          "name": "keyword.operator.spread.unsound",
          "match": "\\.\\.\\."
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.unsound",
          "match": "\\b([a-zA-Z_$][a-zA-Z0-9_$]*)\\s*(?=\\()"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.unsound",
          "match": "\\b[a-zA-Z_$][a-zA-Z0-9_$]*\\b"
        }
      ]
    }
  }
}
