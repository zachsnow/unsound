--- array join returns string
[1, 2, 3].join(",")
=== parse, compile, emit, interpret: $type
{"type": "String"}

--- array includes returns boolean
[1, 2, 3].includes(2)
=== parse, compile, emit, interpret: $type
{"type": "Boolean"}

--- array indexOf returns number
[1, 2, 3].indexOf(2)
=== parse, compile, emit, interpret: $type
{"type": "Number"}

# =============================================================================
# REAL-WORLD EXAMPLE: ZIP WITH LENGTH CONSTRAINT
# =============================================================================
# A zip function that uses SameLen as an assertion to enforce same-length
# arrays. The assertion is called at the start of the function body.

--- zip with assertion passes
let SameLen = (a, b) =>
  if a.length == b.length then true
  else Error("zip requires same-length arrays");
let zip = (a, b) => {
  SameLen(a, b);
  let result = [];
  let go = (i) =>
    if i >= a.length then result
    else { result.push([a[i], b[i]]); go(i + 1) };
  go(0)
};
zip([1, 2, 3], ["a", "b", "c"])
=== parse, compile, emit, interpret: $type
{"type": "Array", "elements": []}

--- zip with assertion fails on different lengths
let SameLen = (a, b) =>
  if a.length == b.length then true
  else Error("zip requires same-length arrays");
let zip = (a, b) => {
  SameLen(a, b);
  let result = [];
  let go = (i) =>
    if i >= a.length then result
    else { result.push([a[i], b[i]]); go(i + 1) };
  go(0)
};
zip([1, 2], ["a", "b", "c"])
=== parse, compile, emit, interpret: $type, error
Type error: zip requires same-length arrays

--- zip runs correctly
let zip = (a, b) => {
  let result = [];
  let go = (i) =>
    if i >= a.length then result
    else { result.push([a[i], b[i]]); go(i + 1) };
  go(0)
};
zip([1, 2, 3], ["a", "b", "c"])
=== parse, compile, emit, interpret
[
  [
    1,
    "a"
  ],
  [
    2,
    "b"
  ],
  [
    3,
    "c"
  ]
]
