# usc -x core -x exo
# Tests for $type phase (type checking)

# =============================================================================
# LITERALS - dependent types preserve known values
# =============================================================================

--- number literal
1
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 1}

--- number zero
0
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 0}

--- number negative
-5
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": -5}

--- string literal
"hello"
=== parse, compile, emit, interpret: $type
{"type": "String", "value": "hello"}

--- string empty
""
=== parse, compile, emit, interpret: $type
{"type": "String", "value": ""}

--- boolean true
true
=== parse, compile, emit, interpret: $type
{"type": "Boolean", "value": true}

--- boolean false
false
=== parse, compile, emit, interpret: $type
{"type": "Boolean", "value": false}

--- null literal
null
=== parse, compile, emit, interpret: $type
{"type": "null"}

--- undefined literal
undefined
=== parse, compile, emit, interpret: $type
{"type": "undefined"}

# =============================================================================
# ARITHMETIC OPERATORS - preserve dependent values
# =============================================================================

--- addition
2 + 3
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 5}

--- subtraction
10 - 4
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 6}

--- multiplication
3 * 4
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 12}

--- division
15 / 3
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 5}

--- modulo
17 % 5
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 2}

--- chained arithmetic
1 + 2 + 3
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 6}

--- mixed arithmetic
2 + 3 * 4
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 14}

--- negation
-(5)
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": -5}

# =============================================================================
# COMPARISON OPERATORS - return dependent booleans
# =============================================================================

--- less than true
3 < 5
=== parse, compile, emit, interpret: $type
{"type": "Boolean", "value": true}

--- less than false
5 < 3
=== parse, compile, emit, interpret: $type
{"type": "Boolean", "value": false}

--- greater than true
5 > 3
=== parse, compile, emit, interpret: $type
{"type": "Boolean", "value": true}

--- less than or equal
3 <= 3
=== parse, compile, emit, interpret: $type
{"type": "Boolean", "value": true}

--- greater than or equal
5 >= 5
=== parse, compile, emit, interpret: $type
{"type": "Boolean", "value": true}

--- equality true
5 == 5
=== parse, compile, emit, interpret: $type
{"type": "Boolean", "value": true}

--- equality false
5 == 6
=== parse, compile, emit, interpret: $type
{"type": "Boolean", "value": false}

--- inequality
5 != 6
=== parse, compile, emit, interpret: $type
{"type": "Boolean", "value": true}

--- string equality
"foo" == "foo"
=== parse, compile, emit, interpret: $type
{"type": "Boolean", "value": true}

--- string inequality
"foo" != "bar"
=== parse, compile, emit, interpret: $type
{"type": "Boolean", "value": true}

# =============================================================================
# LOGICAL OPERATORS
# =============================================================================

--- logical not true
!false
=== parse, compile, emit, interpret: $type
{"type": "Boolean", "value": true}

--- logical not false
!true
=== parse, compile, emit, interpret: $type
{"type": "Boolean", "value": false}

--- double negation
!!true
=== parse, compile, emit, interpret: $type
{"type": "Boolean", "value": true}

# =============================================================================
# STRING OPERATORS
# =============================================================================

--- string concat
"hello" + " world"
=== parse, compile, emit, interpret: $type
{"type": "String", "value": "hello world"}

--- string concat empty
"" + "foo"
=== parse, compile, emit, interpret: $type
{"type": "String", "value": "foo"}

# =============================================================================
# CONDITIONALS - dependent booleans enable branch pruning
# =============================================================================

--- if true takes then branch
if true then 1 else 2
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 1}

--- if false takes else branch
if false then 1 else 2
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 2}

--- if computed true
if 5 > 3 then "yes" else "no"
=== parse, compile, emit, interpret: $type
{"type": "String", "value": "yes"}

--- if computed false
if 3 > 5 then "yes" else "no"
=== parse, compile, emit, interpret: $type
{"type": "String", "value": "no"}

--- if avoids error in unused branch
if true then 42 else null.explode
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 42}

--- if avoids error in then branch
if false then null.explode else 42
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 42}

# =============================================================================
# LET BINDINGS
# =============================================================================

--- let preserves dependent type
let x = 5; x
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 5}

--- let with arithmetic
let x = 2; let y = 3; x + y
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 5}

--- let shadowing
let x = 1; let x = 2; x
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 2}

# =============================================================================
# FUNCTIONS
# =============================================================================

--- identity function
let id = (x) => x; id(42)
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 42}

--- constant function
let k = (x) => 1; k("ignored")
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 1}

--- two arg function
let add = (a, b) => a + b; add(2, 3)
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 5}

# =============================================================================
# OBJECTS
# =============================================================================

--- empty object
({})
=== parse, compile, emit, interpret: $type
{"props": {}, "type": "Object"}

--- object with props
({x: 1, y: 2})
=== parse, compile, emit, interpret: $type
{"props": {"x": {"type": "Number", "value": 1}, "y": {"type": "Number", "value": 2}}, "type": "Object"}

# =============================================================================
# ARRAYS
# =============================================================================

--- empty array
[]
=== parse, compile, emit, interpret: $type
{"elements": [], "type": "Array"}

--- array of numbers
[1, 2, 3]
=== parse, compile, emit, interpret: $type
{"elements": [{"type": "Number", "value": 1}, {"type": "Number", "value": 2}, {"type": "Number", "value": 3}], "type": "Array"}

# =============================================================================
# RECURSION - dependent values enable termination
# =============================================================================

--- recursive with dependent input works
let fact = (n) => if n <= 1 then 1 else n * fact(n - 1); fact(5)
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 120}

--- recursive with dependent zero
let fact = (n) => if n <= 1 then 1 else n * fact(n - 1); fact(0)
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 1}

--- recursive with non-dependent input causes stack overflow
let fact = (n) => if n <= 1 then 1 else n * fact(n - 1); let x: Number = 5; fact(x)
=== parse, compile, emit, interpret: $type, error
Maximum call stack size exceeded

--- recursive with function annotation works
let fact: (n) => Number = (n) => if n <= 1 then 1 else n * fact(n - 1); let x: Number = 5; fact(x)
=== parse, compile, emit, interpret: $type
{"type": "Number"}

--- annotated also works with dependent number
let fact: (n) => Number = (n) => if n <= 1 then 1 else n * fact(n - 1); fact(5)
=== parse, compile, emit, interpret: $type
{"type": "Number"}

# =============================================================================
# TYPE ERRORS
# =============================================================================

--- type error: number plus string
1 + "hello"
=== parse, compile, emit, interpret: $type, error
Type error: expected Number, got String

--- type error: string minus number
"hello" - 1
=== parse, compile, emit, interpret: $type, error
Type error: cannot call non-function type undefined

--- type error: boolean arithmetic
true + 1
=== parse, compile, emit, interpret: $type, error
Type error: cannot call non-function type undefined

#
# Type annotations
#

--- simple annotation
let x: Number = 42; x
=== parse, compile, emit, interpret: $type
{"type": "Number"}

--- annotation widens to non-dependent
let x: Number = 42; x + 1
=== parse, compile, emit, interpret: $type
{"type": "Number"}

#
# Type annotation errors
#

--- annotation mismatch error
let x: String = 42; x
=== parse, compile, emit, interpret: $type, error
Type error: expected String, got Number

--- annotation mismatch in block
{ let x: Boolean = "hello"; x }
=== parse, compile, emit, interpret: $type, error
Type error: expected Boolean, got String

# =============================================================================
# BLOCKS
# =============================================================================

--- block returns last expression
{ 1; 2; 3 }
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 3}

--- block with let
{ let x = 1; x + 1 }
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 2}

--- nested blocks
{ let x = 1; { let y = 2; x + y } }
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 3}

# =============================================================================
# STRING LENGTH
# =============================================================================

--- string length dependent
"hello".length
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 5}

--- empty string length
"".length
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 0}

--- string length non-dependent
let s: String = "hello"; s.length
=== parse, compile, emit, interpret: $type
{"type": "Number"}

# =============================================================================
# ARRAY LENGTH
# =============================================================================

--- array length dependent
[1, 2, 3].length
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 3}

--- empty array length
[].length
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 0}

# =============================================================================
# ARRAY INDEXING
# =============================================================================

--- array index dependent
[10, 20, 30][1]
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 20}

--- array index zero
[10, 20, 30][0]
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 10}

--- array index out of bounds
[10, 20, 30][5]
=== parse, compile, emit, interpret: $type
{"type": "undefined"}

--- array index non-dependent returns set with undefined
let i: Number = 0; [10, 20, 30][i]
=== parse, compile, emit, interpret: $type
{"type": "Set", "types": [{"type": "Number", "value": 10}, {"type": "Number", "value": 20}, {"type": "Number", "value": 30}, {"type": "undefined"}]}

# =============================================================================
# OBJECT INDEXING
# =============================================================================

--- object index dependent string
({x: 1, y: 2})["x"]
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 1}

--- object dot access
({x: 1, y: 2}).y
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 2}

--- object index missing key
({x: 1})["z"]
=== parse, compile, emit, interpret: $type
{"type": "Set", "types": [{"type": "Number", "value": 1}, {"type": "undefined"}]}

--- object index non-dependent returns set with undefined
let k: String = "x"; ({x: 1, y: 2})[k]
=== parse, compile, emit, interpret: $type
{"type": "Set", "types": [{"type": "Number", "value": 1}, {"type": "Number", "value": 2}, {"type": "undefined"}]}

# =============================================================================
# SETTYPE FROM ASSIGNMENT
# =============================================================================

--- assignment creates set type
let x = 1; x = "foo"; x
=== parse, compile, emit, interpret: $type
{"type": "Set", "types": [{"type": "Number", "value": 1}, {"type": "String", "value": "foo"}]}

--- multiple assignments accumulate
let x = 1; x = 2; x = 3; x
=== parse, compile, emit, interpret: $type
{"type": "Set", "types": [{"type": "Number", "value": 1}, {"type": "Number", "value": 2}, {"type": "Number", "value": 3}]}

# =============================================================================
# SETTYPE FORWARDING
# =============================================================================

--- settype forwards operators
let x = 1; x = 2; x + 10
=== parse, compile, emit, interpret: $type
{"type": "Set", "types": [{"type": "Number", "value": 11}, {"type": "Number", "value": 12}]}

--- settype forwards comparison
let x = 1; x = 5; x > 3
=== parse, compile, emit, interpret: $type
{"type": "Set", "types": [{"type": "Boolean", "value": false}, {"type": "Boolean", "value": true}]}

# =============================================================================
# NON-DEPENDENT CONDITIONALS
# =============================================================================

--- if non-dependent condition returns set
let b: Boolean = true; if b then 1 else 2
=== parse, compile, emit, interpret: $type
{"type": "Set", "types": [{"type": "Number", "value": 1}, {"type": "Number", "value": 2}]}

--- if non-dependent mixed types
let b: Boolean = true; if b then "yes" else 42
=== parse, compile, emit, interpret: $type
{"type": "Set", "types": [{"type": "String", "value": "yes"}, {"type": "Number", "value": 42}]}

# =============================================================================
# LOGICAL AND / OR
# =============================================================================

--- logical and returns set
true && false
=== parse, compile, emit, interpret: $type
{"type": "Set", "types": [{"type": "Boolean", "value": true}, {"type": "Boolean", "value": false}]}

--- logical or returns set
true || false
=== parse, compile, emit, interpret: $type
{"type": "Set", "types": [{"type": "Boolean", "value": true}, {"type": "Boolean", "value": false}]}

--- and with non-boolean
1 && "hello"
=== parse, compile, emit, interpret: $type
{"type": "Set", "types": [{"type": "Number", "value": 1}, {"type": "String", "value": "hello"}]}

--- or with non-boolean
null || 42
=== parse, compile, emit, interpret: $type
{"type": "Set", "types": [{"type": "null"}, {"type": "Number", "value": 42}]}

# =============================================================================
# STRICT EQUALITY
# =============================================================================

--- strict equality same type
5 === 5
=== parse, compile, emit, interpret: $type
{"type": "Boolean"}

--- strict equality different types
5 === "5"
=== parse, compile, emit, interpret: $type
{"type": "Boolean"}

--- strict inequality
5 !== 6
=== parse, compile, emit, interpret: $type
{"type": "Boolean"}

# =============================================================================
# ANYTYPE
# =============================================================================

--- any type from environment
Any
=== parse, compile, emit, interpret: $type
{"type": "Any"}

--- any property access returns any
Any.foo
=== parse, compile, emit, interpret: $type
{"type": "Any"}

--- any chained access returns any
Any.foo.bar.baz
=== parse, compile, emit, interpret: $type
{"type": "Any"}

--- any call returns any
Any!
=== parse, compile, emit, interpret: $type
{"type": "Any"}

--- any indexed returns any
Any["key"]
=== parse, compile, emit, interpret: $type
{"type": "Any"}

--- any in arithmetic returns any
Any + 1
=== parse, compile, emit, interpret: $type
{"type": "Any"}

# =============================================================================
# COOL DEPENDENT TYPES - stuff that's hard in TypeScript
# =============================================================================

# In TS, this requires complex conditional types with Subtract/Add utility types
# built from tuple manipulation. Here it's just... math.

--- fibonacci at type level
let fib = (n) => if n <= 1 then n else fib(n - 1) + fib(n - 2); fib(10)
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 55}

--- power of 2 at type level
let pow2 = (n) => if n == 0 then 1 else 2 * pow2(n - 1); pow2(8)
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 256}

# TS FizzBuzz types require nested conditional types:
# type FizzBuzz<N> = N extends ... ? "FizzBuzz" : N extends ... ? "Fizz" : ...
# Here it's just if/else.

--- fizzbuzz at type level
let fizzbuzz = (n) =>
  if n % 15 == 0 then "FizzBuzz"
  else if n % 3 == 0 then "Fizz"
  else if n % 5 == 0 then "Buzz"
  else n;
fizzbuzz(15)
=== parse, compile, emit, interpret: $type
{"type": "String", "value": "FizzBuzz"}

--- fizzbuzz fizz
let fizzbuzz = (n) =>
  if n % 15 == 0 then "FizzBuzz"
  else if n % 3 == 0 then "Fizz"
  else if n % 5 == 0 then "Buzz"
  else n;
fizzbuzz(9)
=== parse, compile, emit, interpret: $type
{"type": "String", "value": "Fizz"}

--- fizzbuzz buzz
let fizzbuzz = (n) =>
  if n % 15 == 0 then "FizzBuzz"
  else if n % 3 == 0 then "Fizz"
  else if n % 5 == 0 then "Buzz"
  else n;
fizzbuzz(10)
=== parse, compile, emit, interpret: $type
{"type": "String", "value": "Buzz"}

--- fizzbuzz number
let fizzbuzz = (n) =>
  if n % 15 == 0 then "FizzBuzz"
  else if n % 3 == 0 then "Fizz"
  else if n % 5 == 0 then "Buzz"
  else n;
fizzbuzz(7)
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 7}

# TS would need: type GCD<A, B> = B extends 0 ? A : GCD<B, Mod<A, B>>
# with Mod requiring tuple gymnastics. Here it's recursive with real modulo.

--- gcd at type level
let gcd = (a, b) => if b == 0 then a else gcd(b, a % b); gcd(48, 18)
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 6}

--- gcd coprime
let gcd = (a, b) => if b == 0 then a else gcd(b, a % b); gcd(17, 13)
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 1}

# Vector length checking - in TS you'd use tuple lengths and conditional types
# with complex inference. Here we just compare .length directly.

--- vectors same length check
let samelen = (a, b) => a.length == b.length;
samelen([1,2,3], [4,5,6])
=== parse, compile, emit, interpret: $type
{"type": "Boolean", "value": true}

--- vectors different length check
let samelen = (a, b) => a.length == b.length;
samelen([1,2], [4,5,6])
=== parse, compile, emit, interpret: $type
{"type": "Boolean", "value": false}

--- conditional on array lengths
let zipOrError = (a, b) =>
  if a.length == b.length then "ok" else "length mismatch";
zipOrError([1,2,3], [4,5,6])
=== parse, compile, emit, interpret: $type
{"type": "String", "value": "ok"}

--- conditional on array lengths mismatch
let zipOrError = (a, b) =>
  if a.length == b.length then "ok" else "length mismatch";
zipOrError([1,2], [4,5,6])
=== parse, compile, emit, interpret: $type
{"type": "String", "value": "length mismatch"}

# String length arithmetic - TS template literal types can't do arithmetic
# on string lengths without tuple hacks.

--- string length arithmetic
let longerThan = (s, n) => s.length > n;
longerThan("hello", 3)
=== parse, compile, emit, interpret: $type
{"type": "Boolean", "value": true}

--- string length comparison
"hello".length + "world".length
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 10}

# Absolute value - trivial here, requires conditional type in TS

--- absolute value
let abs = (n) => if n < 0 then -n else n; abs(-42)
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 42}

--- absolute value positive
let abs = (n) => if n < 0 then -n else n; abs(42)
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 42}

# Clamp - two conditions, in TS needs nested conditionals

--- clamp value
let clamp = (n, lo, hi) => if n < lo then lo else if n > hi then hi else n;
clamp(50, 0, 100)
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 50}

--- clamp below min
let clamp = (n, lo, hi) => if n < lo then lo else if n > hi then hi else n;
clamp(-10, 0, 100)
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 0}

--- clamp above max
let clamp = (n, lo, hi) => if n < lo then lo else if n > hi then hi else n;
clamp(150, 0, 100)
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 100}

# Collatz conjecture step - mix of conditionals and arithmetic

--- collatz step even
let collatz = (n) => if n % 2 == 0 then n / 2 else 3 * n + 1;
collatz(16)
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 8}

--- collatz step odd
let collatz = (n) => if n % 2 == 0 then n / 2 else 3 * n + 1;
collatz(5)
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 16}

# isPrime - loop-like recursion, very hard in TS type system

--- primality check prime
let isPrime = (n) => {
  let check = (n, d) => if d * d > n then true else if n % d == 0 then false else check(n, d + 1);
  if n < 2 then false else check(n, 2)
};
isPrime(17)
=== parse, compile, emit, interpret: $type
{"type": "Boolean", "value": true}

--- primality check composite
let isPrime = (n) => {
  let check = (n, d) => if d * d > n then true else if n % d == 0 then false else check(n, d + 1);
  if n < 2 then false else check(n, 2)
};
isPrime(15)
=== parse, compile, emit, interpret: $type
{"type": "Boolean", "value": false}

--- primality check small
let isPrime = (n) => {
  let check = (n, d) => if d * d > n then true else if n % d == 0 then false else check(n, d + 1);
  if n < 2 then false else check(n, 2)
};
isPrime(2)
=== parse, compile, emit, interpret: $type
{"type": "Boolean", "value": true}

# =============================================================================
# GENERICS - polymorphic functions without dependent values
# =============================================================================

--- generic identity
let id = (x) => x;
let n: Number = id(42);
n
=== parse, compile, emit, interpret: $type
{"type": "Number"}

--- generic identity string
let id = (x) => x;
let s: String = id("hello");
s
=== parse, compile, emit, interpret: $type
{"type": "String"}

--- generic constant
let const = (x, y) => x;
let n: Number = const(1, "ignored");
n
=== parse, compile, emit, interpret: $type
{"type": "Number"}

--- generic flip
let flip = (f) => (a, b) => f(b, a);
let sub = (x, y) => x - y;
flip(sub)(3, 10)
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 7}

--- generic compose
let compose = (f, g) => (x) => f(g(x));
let double = (x) => x * 2;
let inc = (x) => x + 1;
compose(double, inc)(5)
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 12}

--- generic apply
let apply = (f, x) => f(x);
let square = (x) => x * x;
apply(square, 4)
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 16}

--- generic twice
let twice = (f) => (x) => f(f(x));
let inc = (x) => x + 1;
twice(inc)(5)
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 7}

--- generic pair fst
let pair = (a, b) => (f) => f(a, b);
let fst = (a, b) => a;
let p = pair(1, "hello");
p(fst)
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 1}

--- generic pair snd
let pair = (a, b) => (f) => f(a, b);
let snd = (a, b) => b;
let p = pair(1, "hello");
p(snd)
=== parse, compile, emit, interpret: $type
{"type": "String", "value": "hello"}

--- generic either left
let left = (x) => (onLeft, onRight) => onLeft(x);
let right = (x) => (onLeft, onRight) => onRight(x);
let e = left(42);
e((n) => n + 1, (s) => 0)
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 43}

--- generic either right
let left = (x) => (onLeft, onRight) => onLeft(x);
let right = (x) => (onLeft, onRight) => onRight(x);
let e = right("hello");
e((n) => n + 1, (s) => s.length)
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 5}

--- generic maybe nothing
let nothing = (onNothing, onJust) => onNothing;
let just = (x) => (onNothing, onJust) => onJust(x);
nothing(0, (x) => x + 1)
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 0}

--- generic maybe just
let nothing = (onNothing, onJust) => onNothing;
let just = (x) => (onNothing, onJust) => onJust(x);
just(41)(0, (x) => x + 1)
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 42}

--- annotated function erases value
let f: (x) => Number = (x) => x + 1;
f(5)
=== parse, compile, emit, interpret: $type
{"type": "Number"}

--- generic pipeline
let pipe = (x, f) => f(x);
let r = pipe(5, (x) => x * 2);
r
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 10}

--- pipeline chain
let pipe = (x, f) => f(x);
pipe(pipe(pipe(1, (x) => x + 1), (x) => x * 2), (x) => x + 10)
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 14}

--- church numeral zero
let zero = (f) => (x) => x;
let succ = (n) => (f) => (x) => f(n(f)(x));
let toInt = (n) => n((x) => x + 1)(0);
toInt(zero)
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 0}

--- church numeral three
let zero = (f) => (x) => x;
let succ = (n) => (f) => (x) => f(n(f)(x));
let toInt = (n) => n((x) => x + 1)(0);
let three = succ(succ(succ(zero)));
toInt(three)
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 3}

--- church add
let zero = (f) => (x) => x;
let succ = (n) => (f) => (x) => f(n(f)(x));
let add = (m, n) => (f) => (x) => m(f)(n(f)(x));
let toInt = (n) => n((x) => x + 1)(0);
let two = succ(succ(zero));
let three = succ(two);
toInt(add(two, three))
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 5}

# =============================================================================
# COMPILE-TIME LENGTH CHECKING
# =============================================================================
# A function that produces a type error when passed lists that aren't
# provably the same length. Uses the trick that `if` with a dependent
# boolean only evaluates one branch, so we put Error("...") in the else
# branch to throw a custom type error.

--- same length passes
let requireSameLen = (a, b) =>
  if a.length == b.length then "ok"
  else Error("arrays must have the same length");
requireSameLen([1,2,3], [4,5,6])
=== parse, compile, emit, interpret: $type
{"type": "String", "value": "ok"}

--- different length errors
let requireSameLen = (a, b) =>
  if a.length == b.length then "ok"
  else Error("arrays must have the same length");
requireSameLen([1,2], [4,5,6])
=== parse, compile, emit, interpret: $type, error
Type error: arrays must have the same length

--- non-dependent length errors (Any erases length info)
let requireSameLen = (a, b) =>
  if a.length == b.length then "ok"
  else Error("cannot prove arrays have the same length");
let a: Any = [1,2,3];
let b: Any = [4,5,6];
requireSameLen(a, b)
=== parse, compile, emit, interpret: $type, error
Type error: cannot prove arrays have the same length

--- zip only same length
let zip = (a, b) =>
  if a.length == b.length then "zipped"
  else Error("zip requires same-length arrays");
zip([1,2], [3,4])
=== parse, compile, emit, interpret: $type
{"type": "String", "value": "zipped"}

--- zip rejects different lengths
let zip = (a, b) =>
  if a.length == b.length then "zipped"
  else Error("zip requires same-length arrays");
zip([1], [3,4,5])
=== parse, compile, emit, interpret: $type, error
Type error: zip requires same-length arrays

--- matrix dimensions check
let matmul = (a, b) =>
  if a[0].length == b.length then "valid"
  else Error("matrix inner dimensions must match");
matmul([[1,2,3], [4,5,6]], [[1], [2], [3]])
=== parse, compile, emit, interpret: $type
{"type": "String", "value": "valid"}

--- matrix dimensions mismatch
let matmul = (a, b) =>
  if a[0].length == b.length then "valid"
  else Error("matrix inner dimensions must match");
matmul([[1,2], [3,4]], [[1], [2], [3]])
=== parse, compile, emit, interpret: $type, error
Type error: matrix inner dimensions must match

--- custom error for bounds check
let safeIndex = (arr, i) =>
  if i >= 0 then
    if i < arr.length then arr[i]
    else Error("index out of bounds: too large")
  else Error("index out of bounds: negative");
safeIndex([10, 20, 30], 1)
=== parse, compile, emit, interpret: $type
{"type": "Number", "value": 20}

--- bounds check negative
let safeIndex = (arr, i) =>
  if i >= 0 then
    if i < arr.length then arr[i]
    else Error("index out of bounds: too large")
  else Error("index out of bounds: negative");
safeIndex([10, 20, 30], -1)
=== parse, compile, emit, interpret: $type, error
Type error: index out of bounds: negative

--- bounds check too large
let safeIndex = (arr, i) =>
  if i >= 0 then
    if i < arr.length then arr[i]
    else Error("index out of bounds: too large")
  else Error("index out of bounds: negative");
safeIndex([10, 20, 30], 5)
=== parse, compile, emit, interpret: $type, error
Type error: index out of bounds: too large

