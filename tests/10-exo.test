# usc -x core -x exo
# Tests for exo.ts extension (operators, statements, blocks, assignment, type annotations)

# =============================================================================
# BINARY OPERATORS - Arithmetic
# =============================================================================

--- addition
1 + 2
===
3

--- addition with zero
0 + 5
===
5

--- addition negative
-3 + 5
===
2

--- subtraction
10 - 3
===
7

--- subtraction negative result
3 - 10
===
-7

--- subtraction from zero
0 - 5
===
-5

--- multiplication
4 * 5
===
20

--- multiplication by zero
100 * 0
===
0

--- multiplication negative
-3 * 4
===
-12

--- multiplication two negatives
-3 * -4
===
12

--- division
20 / 4
===
5

--- division decimal result
7 / 2
===
3.5

--- division by one
42 / 1
===
42

--- modulo
10 % 3
===
1

--- modulo even division
10 % 5
===
0

--- modulo larger divisor
3 % 10
===
3

--- modulo with one
7 % 1
===
0

# =============================================================================
# BINARY OPERATORS - Comparison
# =============================================================================

--- less than true
3 < 5
===
true

--- less than false
5 < 3
===
false

--- less than equal
3 < 3
===
false

--- greater than true
5 > 3
===
true

--- greater than false
3 > 5
===
false

--- greater than equal
3 > 3
===
false

--- less than or equal true less
3 <= 5
===
true

--- less than or equal true equal
3 <= 3
===
true

--- less than or equal false
5 <= 3
===
false

--- greater than or equal true greater
5 >= 3
===
true

--- greater than or equal true equal
3 >= 3
===
true

--- greater than or equal false
3 >= 5
===
false

--- negative comparison
-5 < -3
===
true

--- negative comparison greater
-3 > -5
===
true

--- zero comparisons
0 < 1
===
true

--- zero comparison greater
0 > -1
===
true

# =============================================================================
# BINARY OPERATORS - Equality
# =============================================================================

--- equality numbers true
3 == 3
===
true

--- equality numbers false
3 == 4
===
false

--- equality strings true
"hello" == "hello"
===
true

--- equality strings false
"hello" == "world"
===
false

--- equality booleans true
true == true
===
true

--- equality booleans false
true == false
===
false

--- not equal true
3 != 4
===
true

--- not equal false
3 != 3
===
false

--- strict equality numbers
3 === 3
===
true

--- strict equality strings
"foo" === "foo"
===
true

--- strict equality null
null === null
===
true

--- strict equality undefined
undefined === undefined
===
true

--- strict not equal true
3 !== 4
===
true

--- strict not equal false
3 !== 3
===
false

--- strict not equal null
null !== undefined
===
true

--- zero equality
0 == 0
===
true

--- negative zero
-0 == 0
===
true

# =============================================================================
# BINARY OPERATORS - Logical
# =============================================================================

--- and true true
true && true
===
true

--- and true false
true && false
===
false

--- and false true
false && true
===
false

--- and false false
false && false
===
false

--- or true true
true || true
===
true

--- or true false
true || false
===
true

--- or false true
false || true
===
true

--- or false false
false || false
===
false

--- and short circuit
false && (1 / 0)
===
false

--- or short circuit
true || (1 / 0)
===
true

# =============================================================================
# STRING OPERATORS
# =============================================================================

--- string concatenation
"hello" + " " + "world"
===
"hello world"

--- string number concat
"value: " + 42
===
"value: 42"

--- number string concat
42 + " is the answer"
===
"42 is the answer"

--- empty string concat
"" + "hello"
===
"hello"

