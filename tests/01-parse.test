# usc -x core
# Parser tests

--- literal number
42
=== parse: $parse
{
  "type": "LiteralExpr",
  "value": 42
}

--- literal string
"hello"
=== parse: $parse
{
  "type": "LiteralExpr",
  "value": "hello"
}

--- identifier
foo
=== parse: $parse
{
  "name": "foo",
  "type": "IdentifierExpr"
}

--- simple let
let x = 1 in x
=== parse: $parse
{
  "body": {
    "name": "x",
    "type": "IdentifierExpr"
  },
  "name": "x",
  "type": "LetExpr",
  "value": {
    "type": "LiteralExpr",
    "value": 1
  }
}

--- lambda no params
() => 1
=== parse: $parse
{
  "body": {
    "type": "LiteralExpr",
    "value": 1
  },
  "params": [],
  "type": "LambdaExpr"
}

--- lambda with params
(x, y) => x
=== parse: $parse
{
  "body": {
    "name": "x",
    "type": "IdentifierExpr"
  },
  "params": [
    { "name": "x" },
    { "name": "y" }
  ],
  "type": "LambdaExpr"
}

--- if expression
if true then 1 else 2
=== parse: $parse
{
  "cond": {
    "type": "LiteralExpr",
    "value": true
  },
  "else": {
    "type": "LiteralExpr",
    "value": 2
  },
  "then": {
    "type": "LiteralExpr",
    "value": 1
  },
  "type": "IfExpr"
}

--- function application
f(1, 2)
=== parse: $parse
{
  "args": [
    {
      "type": "LiteralExpr",
      "value": 1
    },
    {
      "type": "LiteralExpr",
      "value": 2
    }
  ],
  "fn": {
    "name": "f",
    "type": "IdentifierExpr"
  },
  "type": "AppExpr"
}

--- member access
x.y
=== parse: $parse
{
  "key": {
    "type": "LiteralExpr",
    "value": "y"
  },
  "object": {
    "name": "x",
    "type": "IdentifierExpr"
  },
  "type": "IndexExpr"
}

--- empty object
{}
=== parse: $parse
{
  "properties": [],
  "type": "ObjectExpr"
}

--- object with properties
{ x: 1, y: 2 }
=== parse: $parse
{
  "properties": [
    {
      "key": "x",
      "value": {
        "type": "LiteralExpr",
        "value": 1
      }
    },
    {
      "key": "y",
      "value": {
        "type": "LiteralExpr",
        "value": 2
      }
    }
  ],
  "type": "ObjectExpr"
}

--- index access
x["y"]
=== parse: $parse
{
  "key": {
    "type": "LiteralExpr",
    "value": "y"
  },
  "object": {
    "name": "x",
    "type": "IdentifierExpr"
  },
  "type": "IndexExpr"
}

--- assign index
x["y"] = 1
=== parse: $parse
{
  "key": {
    "type": "LiteralExpr",
    "value": "y"
  },
  "object": {
    "name": "x",
    "type": "IdentifierExpr"
  },
  "type": "AssignIndexExpr",
  "value": {
    "type": "LiteralExpr",
    "value": 1
  }
}

--- nested let
let x = 1 in let y = 2 in x
=== parse: $parse
{
  "body": {
    "body": {
      "name": "x",
      "type": "IdentifierExpr"
    },
    "name": "y",
    "type": "LetExpr",
    "value": {
      "type": "LiteralExpr",
      "value": 2
    }
  },
  "name": "x",
  "type": "LetExpr",
  "value": {
    "type": "LiteralExpr",
    "value": 1
  }
}

--- chained member access
a.b.c
=== parse: $parse
{
  "key": {
    "type": "LiteralExpr",
    "value": "c"
  },
  "object": {
    "key": {
      "type": "LiteralExpr",
      "value": "b"
    },
    "object": {
      "name": "a",
      "type": "IdentifierExpr"
    },
    "type": "IndexExpr"
  },
  "type": "IndexExpr"
}

--- chained function calls
f(1)(2)
=== parse: $parse
{
  "args": [
    {
      "type": "LiteralExpr",
      "value": 2
    }
  ],
  "fn": {
    "args": [
      {
        "type": "LiteralExpr",
        "value": 1
      }
    ],
    "fn": {
      "name": "f",
      "type": "IdentifierExpr"
    },
    "type": "AppExpr"
  },
  "type": "AppExpr"
}

--- parenthesized expression
(42)
=== parse: $parse
{
  "type": "LiteralExpr",
  "value": 42
}

--- nested parentheses
((42))
=== parse: $parse
{
  "type": "LiteralExpr",
  "value": 42
}

--- comment before expression
// this is a comment
42
=== parse: $parse
{
  "type": "LiteralExpr",
  "value": 42
}

--- string with escape
"hello\nworld"
=== parse: $parse
{
  "type": "LiteralExpr",
  "value": "hello\nworld"
}

--- boolean true
true
=== parse: $parse
{
  "type": "LiteralExpr",
  "value": true
}

--- boolean false
false
=== parse: $parse
{
  "type": "LiteralExpr",
  "value": false
}
