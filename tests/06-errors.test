# Negative tests - parse errors and runtime errors

--- parse error: unexpected token
@#$
=== parse, error
Parse error

--- parse error: unclosed paren
(1 + 2
=== parse, error
Parse error

--- parse error: unclosed string
"hello
=== parse, error
Parse error

--- parse error: missing in keyword
let x = 1 x
=== parse, error
Parse error

--- parse error: missing then keyword
if true 1 else 2
=== parse, error
Parse error

--- parse error: missing else keyword
if true then 1
=== parse, error
Parse error

--- parse error: keyword as identifier
let let = 1 in let
=== parse, error
identifier

--- parse error: empty lambda body
() =>
=== parse, error
Parse error

