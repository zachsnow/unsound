# usc -x core
# Tests for compile phase directly (input is AST JSON)

--- compile literal number
{"type":"LiteralExpr","value":42}
=== compile: $compile, emit: $emit
$.number(42)

--- compile literal string
{"type":"LiteralExpr","value":"hello"}
=== compile: $compile, emit: $emit
$.string("hello")

--- compile literal boolean
{"type":"LiteralExpr","value":true}
=== compile: $compile, emit: $emit
$.boolean(true)

--- compile identifier
{"type":"IdentifierExpr","name":"x"}
=== compile: $compile, emit: $emit
$.lookup($env, "x")

--- compile lambda
{"type":"LambdaExpr","params":[{"name": "x"},{"name": "y"}],"body":{"type":"IdentifierExpr","name":"x"}}
=== compile: $compile, emit: $emit
$.lambda($env, ["x", "y"], ($env) => $.lookup($env, "x"))

--- compile application
{"type":"AppExpr","fn":{"type":"IdentifierExpr","name":"f"},"args":[{"type":"LiteralExpr","value":1}]}
=== compile: $compile, emit: $emit
$.call($.lookup($env, "f"), [$.number(1)])

--- compile let
{"type":"LetExpr","name":"x","value":{"type":"LiteralExpr","value":1},"body":{"type":"IdentifierExpr","name":"x"}}
=== compile: $compile, emit: $emit
$.let($env, "x", ($env) => $.number(1), ($env) => $.lookup($env, "x"))

--- compile if
{"type":"IfExpr","cond":{"type":"LiteralExpr","value":true},"then":{"type":"LiteralExpr","value":1},"else":{"type":"LiteralExpr","value":2}}
=== compile: $compile, emit: $emit
$.if($.boolean(true), ($env) => $.number(1), ($env) => $.number(2), $env)

--- compile object
{"type":"ObjectExpr","properties":[{"key":"x","value":{"type":"LiteralExpr","value":1}}]}
=== compile: $compile, emit: $emit
$.object({ ["x"]: $.number(1) })

--- compile index
{"type":"IndexExpr","object":{"type":"IdentifierExpr","name":"o"},"key":{"type":"LiteralExpr","value":"x"}}
=== compile: $compile, emit: $emit
$.index($.lookup($env, "o"), $.string("x"))

--- compile assign index
{"type":"AssignIndexExpr","object":{"type":"IdentifierExpr","name":"o"},"key":{"type":"LiteralExpr","value":"x"},"value":{"type":"LiteralExpr","value":42}}
=== compile: $compile, emit: $emit
$.assignIndex($.lookup($env, "o"), $.string("x"), $.number(42))
